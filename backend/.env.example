DJANGO_SECRET_KEY=change-this-secret-key
# Dedicated JWT HMAC signing key — must be at least 32 bytes. Kept separate from
# DJANGO_SECRET_KEY so rotating one doesn't force-invalidate the other's use. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-32-bytes-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite needs no further config below (uses backend/db.sqlite3).
# Switch to DB_ENGINE=postgres and fill in the DB_* vars when you're ready for it.
DB_ENGINE=sqlite
DB_NAME=customer_enquiry_desk
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

FRONTEND_URL=http://localhost:5173

# Console backend prints reset emails to the runserver terminal — good enough for local
# dev. Switch to django.core.mail.backends.smtp.EmailBackend + fill in the rest for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Vantage <no-reply@vantage.local>
PASSWORD_RESET_TIMEOUT_SECONDS=3600
